# Copy to .env (git-ignored) and fill in for this lab.

# Shown in the login screen's "could not reach the server" hint when a
# https:// host fails with no response -- usually an untrusted certificate.
# Points the user at the Tailscale address instead, which needs no
# click-through. Host[:port], no scheme. Optional: a generic hint is shown
# when this is unset.
VITE_TAILSCALE_HOST=<machine>.<tailnet>.ts.net:8000
